# Copiar este archivo a ".env" en la RAÍZ del proyecto (al lado de package.json)
# y completar usuario y clave. SQL Server en localhost, el mismo que abrís con SSMS.
DB_SERVER=localhost
# Puerto de SQL Server (TCP/IP habilitado, ver docs/DOCUMENTACION_SETUP_BACKEND.md)
DB_PORT=1433
# Si en cambio usás una instancia con nombre, borrá DB_PORT y descomentá la siguiente
# (DB_PORT y DB_INSTANCE no pueden estar juntos):
# DB_INSTANCE=SQLEXPRESS
DB_NAME=BibliotecaDB
DB_USER=biblioteca
DB_PASSWORD=UnaClaveSegura123!
# Puerto del backend (Vite redirige /api a este puerto)
PORT=3001
